# ══════════════════════════════════════════════════════════════
#  Construction Knowledge Assistant — Environment Configuration
#  Copy this file to .env and fill in your own API keys.
#  Command: cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ── MODE 1: LOCAL (free, offline after first download) ────────
EMBEDDING_BACKEND=huggingface
EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_BACKEND=huggingface
LLM_MODEL=google/flan-t5-base
VECTOR_BACKEND=faiss

# ── MODE 2: OPENAI + PINECONE (demo day, best quality) ────────
# EMBEDDING_BACKEND=openai
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_BACKEND=openai
# LLM_MODEL=gpt-3.5-turbo
# VECTOR_BACKEND=pinecone

# ── API Keys ───────────────────────────────────────────────────
# Get your OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Get your Pinecone API key from: https://app.pinecone.io → API Keys
PINECONE_API_KEY=your-pinecone-api-key-here

# ── Pinecone Index Names ───────────────────────────────────────
# cnst-local  → create as 384-dim  (for HuggingFace / all-MiniLM-L6-v2)
# cnst-openai → create as 1536-dim (for OpenAI / text-embedding-3-small)
PINECONE_INDEX_NAME_LOCAL=cnst-local
PINECONE_INDEX_NAME_OPENAI=cnst-openai

# ── Ollama (only needed if LLM_BACKEND=ollama) ─────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Paths ───────────────────────────────────────────────────────
DATA_DIR=./data
VECTOR_STORE_DIR=./vector_store

# ── Chunking ────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ── Retrieval ────────────────────────────────────────────────────
TOP_K=5
RERANKER_TOP_N=3

# ── Hybrid Search ─────────────────────────────────────────────
HYBRID_SEARCH_ENABLED=true
HYBRID_BM25_WEIGHT=0.4
HYBRID_DENSE_WEIGHT=0.6

# ── Re-ranking ────────────────────────────────────────────────
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
